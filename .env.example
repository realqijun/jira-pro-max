# Postgres (docker compose up -d db)
DATABASE_URL=postgres://pm:pm@localhost:5433/pm
# Used by vitest (docker compose up -d db_test)
TEST_DATABASE_URL=postgres://pm:pm@localhost:5434/pm_test

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Canonical public origin for SEO. Required for production builds; use the same
# production HTTPS origin for previews. Never set this to a preview deployment URL.
# SITE_URL=https://your-production-domain.example

# Evidence file storage: "disk" (writes to ./storage) or "vercel-blob"
STORAGE_DRIVER=disk
# Required when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
# Text extracted from uploaded Evidence (PDF, DOCX, text) is cut at this many characters
EVIDENCE_EXTRACT_MAX_CHARS=100000

# Assistant (ADR 0007). The app boots without a key; the dock then says "Assistant not configured".
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Tool-call steps the model may take in one turn, and User turns per UTC day
ASSISTANT_MAX_STEPS=8
ASSISTANT_DAILY_TURN_CAP=50
# Profile and Working Memory size (approximate tokens, 4 chars each)
MEMORY_MAX_TOKENS=2000
# Reflection runs after an Assistant turn only when both thresholds are met
REFLECTION_MIN_MINUTES=5
REFLECTION_MIN_MESSAGES=3

# Concept renders. Deliberately a separate provider from the Assistant above: the render
# preview is free to the User, so it must never spend their OPENAI_API_KEY. The app boots
# without a key; the Renders tab then says previews are not configured and the seeded
# renders still display. Get a server-side sk_ key at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# PostHog analytics (docs/submission/m19-analytics.md). Leave the key empty to send nothing;
# every capture is a no-op without it, in the browser and on the server.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Seed (npm run db:seed) creates this demo account only
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-123

# Proposal pass (issue #39): "model" needs OPENAI_API_KEY; "heuristic" is a deterministic
# sentence matcher used when no key is set or when forced (the e2e suite expects heuristic).
PROPOSALS_EXTRACTOR=

# The seeded Participant of the demo project's messaging surface (ADR 0009), signed in at
# /m/<projectId>/login. A Person, never a user account.
DEMO_MEMBER_EMAIL=jason@example.com
DEMO_MEMBER_PASSWORD=member-password-123
