      "expect": {
        "abstain": false,
        "citeDecisions": ["replication"],
        "mustMention": [["twenty times", "20 times", "full cut-over", "full cutover"]],
        "mustCallTools": ["search_decisions"]
      }
    },
    {
      "id": "w17-label-scoped-search",
      "tags": ["retrieval", "labels"],
      "prompt": "Which Evidence is labelled vendor, and what does it claim?",
      "expect": { "abstain": false, "citeEvidenceAny": ["vendorNote"], "mustMention": [["90", "ninety"]] }
    },
    {
      "id": "w18-linked-evidence",
